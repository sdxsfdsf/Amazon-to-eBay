{
  "manifest_version": 3,
  "name": "Amazon \u2192 eBay Product Assistant",
  "version": "1.0.0",
  "description": "Capture the selected Amazon variant (data + original-quality images) and fill an eBay listing with verified Description, Price, Quantity and real image uploads.",
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "*://*.amazon.com/*",
    "*://*.media-amazon.com/*",
    "*://*.ssl-images-amazon.com/*",
    "*://*.ebay.com/*"
  ],
  "background": {
    "service_worker": "background/serviceWorker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Amazon \u2192 eBay Product Assistant"
  },
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.amazon.com/*",
        "*://*.ebay.com/*"
      ],
      "run_at": "document_start",
      "css": [
        "ui/toolbarBootstrap.css"
      ],
      "js": [
        "ui/toolbarBootstrap.js"
      ]
    },
    {
      "matches": [
        "*://*.amazon.com/*"
      ],
      "run_at": "document_idle",
      "css": [
        "ui/panel.css"
      ],
      "js": [
        "common/domUtils.js",
        "common/storage.js",
        "common/pricing.js",
        "common/clipboard.js",
        "common/descriptionBuilder.js",
        "common/imageStore.js",
        "amazon/amazonDescriptionExtractor.js",
        "amazon/amazonImageParser.js",
        "amazon/amazonVariationDetector.js",
        "amazon/amazonImageResolver.js",
        "amazon/amazonImageCollector.js",
        "amazon/amazonOfferScope.js",
        "amazon/amazonPrimeDetector.js",
        "amazon/amazonReturnDetector.js",
        "amazon/amazonCapture.js",
        "amazon/amazonVariantObserver.js",
        "ui/panel.js",
        "amazon/amazonPanel.js"
      ]
    },
    {
      "matches": [
        "*://*.ebay.com/*"
      ],
      "run_at": "document_idle",
      "css": [
        "ui/panel.css"
      ],
      "js": [
        "common/domUtils.js",
        "common/storage.js",
        "common/pricing.js",
        "common/clipboard.js",
        "common/descriptionBuilder.js",
        "common/imageStore.js",
        "ebay/ebaySectionScanner.js",
        "ebay/ebayRealFieldWriter.js",
        "ebay/ebayDescription.js",
        "ebay/ebayPricing.js",
        "ebay/ebayPhotoUploader.js",
        "ebay/ebayItemSpecificScanner.js",
        "ui/panel.js",
        "ebay/ebayPanel.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "ui/*"
      ],
      "matches": [
        "*://*.amazon.com/*",
        "*://*.ebay.com/*"
      ]
    }
  ]
}
